# Solo nombres y descripción. Los valores van en .env (local, nunca en Git).
NODE_ENV=            # development | test | production
PORT=                # opcional, por defecto 3000
SUPABASE_URL=        # URL del proyecto de Supabase
SUPABASE_ANON_KEY=   # llave pública anon
SUPABASE_SERVICE_ROLE_KEY=  # llave privilegiada: SOLO servidor
SUPABASE_JWT_SECRET= # secreto para verificar JWT
DATABASE_URL=        # cadena directa a PostgreSQL (solo migraciones)
GEMINI_API_KEY=      # llave de Gemini
GEMINI_MODELO=       # opcional, por defecto gemini-2.5-flash
CORS_ORIGENES=       # dominios permitidos, separados por comas
LIMITE_SOLICITUDES_POR_MINUTO=  # opcional, por defecto 60
LIMITE_AGENTE_POR_MINUTO=       # opcional, por defecto 10
PROXIES_DE_CONFIANZA=           # opcional: 0 en tu PC, 1 en Render
# Solo para pruebas de integración de la base (opcional). Superusuario de un PostgreSQL de pruebas.
# Sin esta variable, las pruebas de base se omiten. Nunca apuntar a producción.
TEST_DATABASE_URL=   # cadena de un PostgreSQL local o de pruebas (ej. postgresql://postgres:...@127.0.0.1:5432/postgres)
# Opcionales: usuario de prueba para la prueba de inicio de sesión real (PRUEBAS_SUPABASE=1).
PRUEBAS_SUPABASE_EMAIL=
PRUEBAS_SUPABASE_CLAVE=
